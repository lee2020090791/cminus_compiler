/* A program to perform Euclid's
   Algorithm to computer gcd */

int gcd (int u, int v)
{
	if (v == 0) return u;
	else return gcd(v,u-u/v*v);
	/* u-u/v*v == u mod v */
}
/* check comment ** / uv // /* u-v **/
void main(void)
{
	int x; int y;
	x = input(); y = input();
	int z=0;
	/* check gt, ge */
	if(x>=y) z=z+1;
	if(x>y) z=z+1;
	z = x/y*2; 
	output(gcd(x,y));
}
